# PostgreSQL connection string (required).
# Any Postgres 14+ works (local Docker, Neon, etc.).
DATABASE_URL=""

# Anthropic API key for Claude (required).
# Sign up at https://console.anthropic.com.
ANTHROPIC_API_KEY=""

# Google Places API key (optional, enables RAG mode for venue grounding).
# Without this, the AI guide falls back to parametric LLM knowledge with
# anti-hallucination prompts.
GOOGLE_PLACES_API_KEY=""

# Daily token budget for the whole app (input + output tokens, resets at 00:00
# UTC). Once reached, the guide and the chat stop calling the model until the
# next day. Defaults to 500000 when unset.
DAILY_TOKEN_BUDGET="500000"
